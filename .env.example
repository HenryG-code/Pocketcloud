# Copy to .env and fill in generated values. Never commit the real file.
APP_PROFILE=dev-local
HTTP_ADDR=127.0.0.1:8080

DATABASE_URL=
SESSION_SECRET=

# Internal endpoint for the API, and an endpoint the browser can actually reach.
S3_ENDPOINT_INTERNAL=http://127.0.0.1:8333
S3_ENDPOINT_PUBLIC=http://127.0.0.1:8333
S3_BUCKET=pocketcloud-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Starting limit of 10 GiB total live data. This is not a disk quota.
LIVE_DATA_CAP_BYTES=10737418240
# Set from measurement. Uploads must be refused before this floor is crossed.
PHYSICAL_FREE_SPACE_FLOOR_BYTES=
MAX_CONCURRENT_UPLOADS=2
